# MoonlightWeb — public deployment settings.
#
# Copy to docker/.env (next to docker-compose.public.yml) and edit:
#
#     cp docker/.env.public.example docker/.env
#
# Compose reads .env from the compose file's own directory, so the file must be
# docker/.env even when you run compose from the repository root.

# The name browsers will use: bare host, no scheme, no trailing slash.
# Caddy serves this name (Let's Encrypt certificate) and the app trusts it
# (RequestGuard::isTrustedHost). They must match the DNS record exactly.
MW_DOMAIN=mw.example.com

# Container timezone. Only affects log timestamps.
TZ=Etc/UTC
