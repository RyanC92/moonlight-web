# MoonlightWeb — public deployment settings.
#
# Copy to docker/.env (next to docker-compose.public.yml) and edit:
#
#     cp docker/.env.public.example docker/.env
#
# Compose reads .env from the compose file's own directory, so the file must be
# docker/.env even when you run compose from the repository root.
#
# Nothing here is secret except TUNNEL_TOKEN. Keep this file out of git.

# The name browsers will use: bare host, no scheme, no trailing slash.
# The edge serves this name and the app trusts it
# (RequestGuard::isTrustedHost). They must match the DNS record exactly.
MW_DOMAIN=mw.example.com

# Container timezone. Only affects log timestamps.
TZ=Etc/UTC

# Which edge fronts the app. Exactly one of:
#
#   direct   Caddy on 80/443. Needs a public IP and ports 80/443 open.
#   tunnel   cloudflared. No inbound ports; also requires TUNNEL_TOKEN below.
#   (empty)  No edge container. Use when the host already terminates TLS:
#            Tailscale Serve/Funnel, nginx, Traefik, a Cloudflare Tunnel you
#            run yourself, etc. See docs/EDGE.md.
#
# An empty value is a valid choice:  COMPOSE_PROFILES=
COMPOSE_PROFILES=direct

# Only for COMPOSE_PROFILES=tunnel.
# Zero Trust -> Networks -> Tunnels -> your tunnel -> the token in the install
# command. This is a credential: anyone holding it can run your tunnel.
# TUNNEL_TOKEN=
